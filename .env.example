# ─── STRIPE ───────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── EMAIL (SMTP) ─────────────────────────────────────────────
# Gmail: use an App Password (https://myaccount.google.com/apppasswords)
# SendGrid: use smtp.sendgrid.net port 587, user=apikey, pass=SG.xxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
EMAIL_FROM_NAME=Your Name
EMAIL_FROM_ADDRESS=your@email.com

# ─── EBOOK ────────────────────────────────────────────────────
# Path to your ebook PDF file (relative to project root)
EBOOK_FILE_PATH=./ebook.pdf
EBOOK_TITLE=The Ultimate Guide
EBOOK_PRICE=2700
# Price in cents (2700 = $27.00)

# ─── SITE ─────────────────────────────────────────────────────
SITE_URL=https://yourdomain.com
ADMIN_PASSWORD=change-me-to-something-secure
PORT=3000
NODE_ENV=production
